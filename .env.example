GEMINI_API_KEY=your_key_here
# Optional. Leave blank to automatically select an available Gemini model.
GEMINI_MODEL=
PORT=3000
# Server-side JSON endpoints. Leave blank until the integrations exist.
GOOGLE_SHEETS_API_URL=
FRENCH_MARKET_API_URL=
# Optional second market request. If blank, the server derives the same endpoint with fuel=e10.
FRENCH_MARKET_PETROL_API_URL=
DAILY_FUEL_DATA_API_URL=
STATION_CONFIG_API_URL=
SUPPLIER_DATA_API_URL=
